# LED Panel Settings
LED_PANEL_MAC=2A:4D:FD:AB:AE:16
LED_DISPLAY_WIDTH=96
LED_DISPLAY_HEIGHT=16

# Server Settings
HTTP_PORT=11001
HTTP_HOST=0.0.0.0

# Debug Settings
DEBUG_BLE=false

# Display Orientation
UPSIDE_DOWN=false

# Live stream (/stream WebSocket): max frames per second sent over Bluetooth
STREAM_FPS=7
# Seconds to wait after the stream disconnects before resuming the playlist
STREAM_RESUME_DELAY=1.5
