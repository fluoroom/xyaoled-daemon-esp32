CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Logs and console over the built-in USB Serial/JTAG (/dev/ttyACM0)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# One 1.5 MB app (no OTA, flashed over USB) and a 2.4 MB LittleFS scratch
# partition for uploads; see partitions.csv
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# BLE: NimBLE as a central with one connection to the panel
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# HTTP: WebSocket for /stream
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Wi-Fi and BLE share the radio
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# RAM: in the C3 IRAM and DRAM are the same SRAM, so code kept in IRAM is
# heap lost. Upload speed is bound by the panel's BLE acks, not Wi-Fi.
CONFIG_SPI_FLASH_ROM_IMPL=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# Saving settings from a Wi-Fi event (setup portal) needs more than the default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
