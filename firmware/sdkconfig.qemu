# QEMU integration-test build, on top of sdkconfig.defaults (see test/qemu).
CONFIG_XY_QEMU=y
CONFIG_BT_ENABLED=n
CONFIG_ETH_USE_OPENETH=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_TASK_WDT_EN=n
# QEMU's ROM lacks the esp_flash implementation the board build uses.
CONFIG_SPI_FLASH_ROM_IMPL=n
# mDNS's Wi-Fi interfaces pull in the Wi-Fi driver, whose start-up ADC
# calibration hangs in QEMU (no SAR ADC there).
CONFIG_MDNS_PREDEF_NETIF_STA=n
CONFIG_MDNS_PREDEF_NETIF_AP=n
